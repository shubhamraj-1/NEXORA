# Optional AI: add a real key to enable planning and answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_S=30
MAX_AI_CONTEXT_CHARS=6000
AI_MAX_PLAN_STEPS=8

# Supabase. Public URL is safe; service role and JWT secret are backend-only.
# SUPABASE_JWT_SECRET can be found in Project Settings > API > JWT Settings.
# Newer projects may use JWKS instead; set SUPABASE_JWKS_URL if needed.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_STORAGE_BUCKET=generated-files
# Set true only after the schema and Storage bucket exist in the target project.
DATABASE_CONFIGURED=false

# Rate limiting for agent and task endpoints.
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_WINDOW_SECONDS=60
